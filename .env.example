# Get free at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Get free at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# What kind of videos to make (used in AI prompt)
